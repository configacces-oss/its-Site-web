# Copiez ce fichier en ".env" puis remplissez les 3 valeurs.

# Adresse publique du site (sans / final)
SITE_URL=https://www.itservices75.fr

# Clé reçue par email sur https://web3forms.com (les demandes de devis arrivent sur cet email)
WEB3FORMS_KEY=

# Jeton du tunnel : Cloudflare > Zero Trust > Networks > Tunnels > votre tunnel
CLOUDFLARE_TUNNEL_TOKEN=
